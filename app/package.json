{
  "name": "treble",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Treble — warm, cross-platform music client (Tauri + React + TypeScript). Built from the Treble design handoff.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "clean:core": "cargo clean -p treble --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "npm run fetch-tools && npm run clean:core && tauri build",
    "android": "tauri android dev --features native-catalog",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk --features native-catalog",
    "fetch-tools": "node ../scripts/fetch-tools.mjs",
    "test:rust": "cd src-tauri && cargo test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
